# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env*
!.env.example

# local editor / OS
.idea/
.vscode/
*.log

# Claude Code per-machine settings — can contain approved commands verbatim,
# including ones with tokens in them. Shared config belongs in .claude/settings.json.
.claude/settings.local.json

# scratch
/supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vercel env import file — contains secrets, never commit
vercel-env.txt
